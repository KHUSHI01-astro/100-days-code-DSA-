#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n];

    for(int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    int key;
    scanf("%d", &key);

    int l = 0, r = n - 1;
    int found = 0;

    while(l <= r) {
        int mid = (l + r) / 2;

        if(a[mid] == key) {
            printf("FOUND %d", mid);
            found = 1;
            break;
        }
        else if(a[mid] < key) {
            l = mid + 1;
        }
        else {
            r = mid - 1;
        }
    }

    if(!found) {
        printf("NOT FOUND");
    }

    return 0;
}
