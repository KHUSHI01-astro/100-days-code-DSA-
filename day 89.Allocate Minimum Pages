#include <stdio.h>

int canAllocate(int a[], int n, int m, int maxPages) {
    int students = 1;
    int pages = 0;

    for(int i = 0; i < n; i++) {
        if(a[i] > maxPages) return 0;

        if(pages + a[i] > maxPages) {
            students++;
            pages = a[i];

            if(students > m)
                return 0;
        } else {
            pages += a[i];
        }
    }

    return 1;
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    int a[n];
    int sum = 0, max = 0;

    for(int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        sum += a[i];
        if(a[i] > max) max = a[i];
    }

    int l = max, r = sum, ans = 0;

    while(l <= r) {
        int mid = (l + r) / 2;

        if(canAllocate(a, n, m, mid)) {
            ans = mid;
            r = mid - 1;
        } else {
            l = mid + 1;
        }
    }

    printf("%d", ans);

    return 0;
}
