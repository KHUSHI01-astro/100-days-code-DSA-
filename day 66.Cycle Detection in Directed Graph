#include <stdio.h>
#include <stdlib.h>

struct Node {
    int vertex;
    struct Node* next;
};

// Create node
struct Node* createNode(int v) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->vertex = v;
    node->next = NULL;
    return node;
}

// Add directed edge
void addEdge(struct Node* adj[], int u, int v) {
    struct Node* node = createNode(v);
    node->next = adj[u];
    adj[u] = node;
}

// DFS cycle detection using recursion stack
int dfsCycle(struct Node* adj[], int v, int visited[], int recStack[]) {
    visited[v] = 1;
    recStack[v] = 1;

    struct Node* temp = adj[v];

    while(temp != NULL) {
        int u = temp->vertex;

        // not visited → go deeper
        if(!visited[u]) {
            if(dfsCycle(adj, u, visited, recStack))
                return 1;
        }
        // already in recursion stack → cycle found
        else if(recStack[u]) {
            return 1;
        }

        temp = temp->next;
    }

    recStack[v] = 0; // remove from recursion stack
    return 0;
}

int isCycle(struct Node* adj[], int n) {
    int visited[n];
    int recStack[n];

    for(int i = 0; i < n; i++) {
        visited[i] = 0;
        recStack[i] = 0;
    }

    for(int i = 0; i < n; i++) {
        if(!visited[i]) {
            if(dfsCycle(adj, i, visited, recStack))
                return 1;
        }
    }

    return 0;
}

int main() {
    int n, m;

    scanf("%d", &n);
    scanf("%d", &m);

    struct Node* adj[n];

    for(int i = 0; i < n; i++)
        adj[i] = NULL;

    for(int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
    }

    if(isCycle(adj, n))
        printf("YES");
    else
        printf("NO");

    return 0;
}
