#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];
    scanf("%s", s);

    int freq[256] = {0};

    for(int i = 0; s[i] != '\0'; i++) {
        freq[(int)s[i]]++;
    }

    for(int i = 0; s[i] != '\0'; i++) {
        if(freq[(int)s[i]] > 1) {
            printf("%c", s[i]);
            return 0;
        }
    }

    printf("-1");

    return 0;
}
