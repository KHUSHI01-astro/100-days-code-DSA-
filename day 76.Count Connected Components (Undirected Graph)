#include <stdio.h>
#include <stdlib.h>

struct Node {
    int v;
    struct Node* next;
};

struct Node* createNode(int v) {
    struct Node* n = (struct Node*)malloc(sizeof(struct Node));
    n->v = v;
    n->next = NULL;
    return n;
}

void addEdge(struct Node* adj[], int u, int v) {
    struct Node* n = createNode(v);
    n->next = adj[u];
    adj[u] = n;

    n = createNode(u);
    n->next = adj[v];
    adj[v] = n;
}

void dfs(struct Node* adj[], int u, int visited[]) {
    visited[u] = 1;

    struct Node* temp = adj[u];
    while(temp != NULL) {
        if(!visited[temp->v]) {
            dfs(adj, temp->v, visited);
        }
        temp = temp->next;
    }
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    struct Node* adj[n + 1];

    for(int i = 0; i <= n; i++)
        adj[i] = NULL;

    for(int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
    }

    int visited[n + 1];
    for(int i = 0; i <= n; i++)
        visited[i] = 0;

    int count = 0;

    for(int i = 1; i <= n; i++) {
        if(!visited[i]) {
            dfs(adj, i, visited);
            count++;
        }
    }

    printf("%d", count);

    return 0;
}
