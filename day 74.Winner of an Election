#include <stdio.h>
#include <string.h>

int main() {
    int n;
    scanf("%d", &n);

    char names[n][50];
    int freq[n];
    
    for(int i = 0; i < n; i++) {
        scanf("%s", names[i]);
        freq[i] = 0;
    }

    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            if(strcmp(names[i], names[j]) == 0) {
                freq[i]++;
            }
        }
    }

    int max = 0;
    char winner[50];

    for(int i = 0; i < n; i++) {
        if(freq[i] > max) {
            max = freq[i];
            strcpy(winner, names[i]);
        }
        else if(freq[i] == max) {
            if(strcmp(names[i], winner) < 0) {
                strcpy(winner, names[i]);
            }
        }
    }

    printf("%s %d", winner, max);

    return 0;
}
